# Copy this file to .env.local and fill in your Supabase project's values to
# use real, persistent, shared crowd data. See README.md > "Supabase setup".
#
# Without these set, the app falls back to a local JSON file
# (.local-data/db.json, gitignored) so `npm run dev` still works with zero
# setup — but that fallback is single-device, non-persistent, and never
# real community data. It logs a warning on startup so it's never mistaken
# for the real thing.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key is intentionally NOT used anywhere in this app — do
# not add it here or reference it in code. Every privileged operation goes
# through a SECURITY DEFINER Postgres function (supabase/functions.sql)
# instead, so the anon key + Row Level Security is the only thing the app
# needs.
