# Not required for local development — the MVP runs on a local JSON file
# (.local-data/db.json, gitignored) with zero setup. These are only needed
# once the project moves to real Supabase (see supabase/schema.sql).
#
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Server-only — NEVER prefix with NEXT_PUBLIC_, never import in client code.
# SUPABASE_SERVICE_ROLE_KEY=
